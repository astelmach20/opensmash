{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public-out",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist,config,visual/assets,engine-dist}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/gcs/:path*",
      "destination": "https://storage.googleapis.com/smash-the-weights-fighter-assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
